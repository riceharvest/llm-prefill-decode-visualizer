{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/calc/:id",
      "destination": "/api/calc?id=:id"
    },
    {
      "source": "/api/watch/dispatch",
      "destination": "/api/watch-dispatch"
    },
    {
      "source": "/v1/calc/:id",
      "destination": "/api/calc?id=:id"
    },
    {
      "source": "/v1/watch/rss.xml",
      "destination": "/api/watch-rss"
    },
    {
      "source": "/v1/watch/dispatch",
      "destination": "/api/watch-dispatch"
    },
    {
      "source": "/v1/agent/capabilities.json",
      "destination": "/api/agent-json?file=capabilities.json"
    },
    {
      "source": "/v1/agent/compute.json",
      "destination": "/api/agent-json?file=compute.json"
    },
    {
      "source": "/v1/agent/benchmarks.json",
      "destination": "/api/agent-json?file=benchmarks.json"
    },
    {
      "source": "/v1/agent/scenario.json",
      "destination": "/api/agent-json?file=scenario.json"
    },
    {
      "source": "/v1/agent/freshness.json",
      "destination": "/api/agent-json?file=freshness.json"
    },
    {
      "source": "/v1/agent/confidence.json",
      "destination": "/api/agent-json?file=confidence.json"
    },
    {
      "source": "/embed",
      "destination": "/index.html"
    },
    {
      "source": "/embed/",
      "destination": "/index.html"
    },
    {
      "source": "/v1/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/localmaxxing-api/leaderboard",
      "destination": "https://www.localmaxxing.com/api/leaderboard"
    },
    {
      "source": "/localmaxxing-api/models",
      "destination": "https://www.localmaxxing.com/api/models"
    },
    {
      "source": "/compare/:a-vs-:b",
      "destination": "/compare.html"
    },
    {
      "source": "/compare/:a-vs-:b/",
      "destination": "/compare.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/.well-known/mcp.json"
    },
    {
      "source": "/problems",
      "destination": "/api/problems"
    },
    {
      "source": "/problems/:code",
      "destination": "/api/problems/:code"
    },
    {
      "source": "/api/:a/:b*",
      "destination": "/api/notfound?a=:a&b=:b*"
    },
    {
      "source": "/api/watch/rss.xml",
      "destination": "/api/watch-rss"
    },
    {
      "source": "/api/agent/capabilities.json",
      "destination": "/api/agent/capabilities"
    },
    {
      "source": "/api/agent/compute.json",
      "destination": "/api/agent/compute"
    },
    {
      "source": "/api/agent/benchmarks.json",
      "destination": "/api/agent/benchmarks"
    },
    {
      "source": "/api/agent/scenario.json",
      "destination": "/api/agent/scenario"
    },
    {
      "source": "/api/agent/freshness.json",
      "destination": "/api/agent/freshness"
    },
    {
      "source": "/api/agent/confidence.json",
      "destination": "/api/agent/confidence"
    },
    {
      "source": "/.well-known/security",
      "destination": "/.well-known/security.txt"
    },
    {
      "source": "/.well-known/ai-plugin",
      "destination": "/.well-known/ai-plugin.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/agents.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/mcp.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/agent/index.json",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/api/agent",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    },
    {
      "source": "/embed/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/watch/dispatch",
      "schedule": "0 6 * * *"
    }
  ]
}
