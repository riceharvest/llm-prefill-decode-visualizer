{
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/index.html"
    },
    {
      "source": "/embed/",
      "destination": "/index.html"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/localmaxxing-api/:path*",
      "destination": "https://www.localmaxxing.com/api/:path*"
    },
    {
      "source": "/compare/:a-vs-:b",
      "destination": "/compare.html"
    }
  ],
  "crons": [
    {
      "path": "/api/watch/dispatch",
      "schedule": "0 6 * * *"
    }
  ]
}
