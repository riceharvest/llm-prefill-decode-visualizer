{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/compute.schema.json",
  "title": "GET|POST /api/compute — request and response schema",
  "description": "LLM inference math API. Accepts GET query parameters or a POST JSON body: pass ?model=<name> plus parameters, or batch up to 50 parameter sets via POST {\"batch\":[...]}. The top-level schema describes the 200 response body (all fields optional because the shape depends on the requested model; per-model required sets are in definitions). definitions.request describes the request body/query.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Deterministic content hash id (calc_*) derived from the resolved inputs; identical resolved inputs always yield the same id."
    },
    "inputs": { "$ref": "#/definitions/inputs" },
    "warnings": {
      "$ref": "#/definitions/sanityWarnings",
      "description": "Non-blocking implausibility warnings; empty when inputs are plausible."
    },
    "dry_run": {
      "type": "boolean",
      "description": "true when the call was a dry_run validation echo; no math was executed."
    },
    "model": {
      "type": "string",
      "enum": ["singleTurn", "speculative", "batched", "agentic", "kvCache", "flagged", "cost"],
      "description": "Echoed model name in dry_run responses."
    },
    "note": { "type": "string", "description": "Human-readable note (dry_run responses)." },
    "batch": { "type": "boolean", "description": "true in batch responses." },
    "count": { "type": "integer", "minimum": 1, "description": "Number of batch items (batch responses)." },
    "okCount": { "type": "integer", "minimum": 0, "description": "Batch items that computed successfully." },
    "errorCount": { "type": "integer", "minimum": 0, "description": "Batch items that failed." },
    "results": {
      "type": "array",
      "items": { "$ref": "#/definitions/batchResult" },
      "description": "Per-item outcome for batch calls; one bad item does not fail the batch."
    },
    "ttftSeconds": { "type": "number", "description": "singleTurn/batched: time to first token in seconds." },
    "tpotMs": { "type": "number", "description": "singleTurn: time per output token in milliseconds." },
    "decodeSeconds": { "type": "number", "description": "singleTurn: decode wall time in seconds." },
    "totalWalltimeSeconds": { "type": "number", "description": "singleTurn/agentic: total wall time in seconds." },
    "effectiveThroughputTokPerSec": { "type": "number", "description": "singleTurn/cost: (promptTokens + outputTokens) / total time." },
    "prefillSharePct": { "type": "number", "description": "singleTurn: share of total time spent prefilling, percent." },
    "decodeSharePct": { "type": "number", "description": "singleTurn: share of total time spent decoding, percent." },
    "effectiveDecodeTokPerSec": { "type": "number", "description": "speculative: effective decode throughput." },
    "speedupVsVanilla": { "type": "number", "description": "speculative: effective decode speed divided by base decode speed." },
    "tokensPerVerifyStep": { "type": "number", "description": "speculative: expected tokens accepted per verify step." },
    "breakevenAcceptanceRate": { "type": "number", "description": "speculative: acceptance rate below which speculation is slower than vanilla decode." },
    "hurtsVsVanilla": { "type": "boolean", "description": "speculative: true when acceptance is at or below the breakeven rate." },
    "perUserDecodeTokPerSec": { "type": "number", "description": "batched: decode speed per user after batch decay." },
    "aggregateDecodeTokPerSec": { "type": "number", "description": "batched: per-user decode speed multiplied by batch size." },
    "perUserDecodeSeconds": { "type": "number", "description": "batched: decode wall time per user in seconds." },
    "perUserTotalSeconds": { "type": "number", "description": "batched: TTFT + per-user decode time in seconds." },
    "turns": {
      "type": "array",
      "items": { "$ref": "#/definitions/agenticTurn" },
      "description": "agentic: per-turn breakdown."
    },
    "finalContextTokens": { "type": "integer", "description": "agentic: context size after the final turn." },
    "walltimeWithoutCachingSeconds": { "type": "number", "description": "agentic: same loop without prefix caching." },
    "cachingSavesSeconds": { "type": "number", "description": "agentic: wall-time saved by prefix caching." },
    "cachingSavesPct": { "type": "number", "description": "agentic: share of uncached wall time saved, percent." },
    "bytesPerToken": { "type": "integer", "description": "kvCache: KV-cache bytes per token." },
    "kbPerToken": { "type": "number", "description": "kvCache: KV-cache KiB per token." },
    "totalGb": { "type": "number", "description": "kvCache: total KV-cache size in GiB." },
    "totalMb": { "type": "number", "description": "kvCache: total KV-cache size in MiB." },
    "formula": { "type": "string", "description": "kvCache: human-readable formula used." },
    "adjusted": {
      "type": "object",
      "properties": {
        "prefillSpeed": { "type": "number" },
        "decodeSpeed": { "type": "number" }
      },
      "description": "flagged: base speeds after applying engine-flag deltas."
    },
    "totalPrefillDeltaPct": { "type": "number", "description": "flagged: combined prefill delta, percent." },
    "totalDecodeDeltaPct": { "type": "number", "description": "flagged: combined decode delta, percent." },
    "adjustments": {
      "type": "array",
      "items": { "type": "object" },
      "description": "flagged: per-flag audit trail (delta + source tag)."
    },
    "simulation": { "$ref": "#/definitions/singleTurnResult", "description": "flagged: single-turn simulation at the adjusted speeds." },
    "requestsPerHour": { "type": "number", "description": "cost: requests per hour at the modeled load." },
    "hardwareCostUsdPerHour": { "type": "number", "description": "cost: amortized hardware cost per hour." },
    "electricityCostUsdPerHour": { "type": "number", "description": "cost: electricity cost per hour." },
    "totalCostUsdPerHour": { "type": "number", "description": "cost: hardware + electricity per hour." },
    "costUsdPerMillionTokens": { "type": ["number", "null"], "description": "cost: USD per million tokens." },
    "costUsdPerThousandRequests": { "type": ["number", "null"], "description": "cost: USD per thousand requests." }
  },
  "required": [],
  "definitions": {
    "request": {
      "title": "Request body (POST) / query parameters (GET)",
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "enum": ["singleTurn", "speculative", "batched", "agentic", "kvCache", "flagged", "cost"],
          "description": "Which simulation to run. Omitted (or empty) returns the capability list."
        },
        "m": { "type": "string", "description": "Alias for model." },
        "promptTokens": { "type": "integer", "minimum": 0, "description": "Prompt tokens (default 2048; 4096 for batched)." },
        "outputTokens": { "type": "integer", "minimum": 0, "description": "Output tokens (default 512)." },
        "prefillSpeed": { "type": "number", "exclusiveMinimum": 0, "description": "Prefill tok/s (default 3800)." },
        "decodeSpeed": { "type": "number", "exclusiveMinimum": 0, "description": "Single-stream decode tok/s (default 105)." },
        "baseDecodeSpeed": { "type": "number", "exclusiveMinimum": 0, "description": "speculative: base decode tok/s (alias: decodeSpeed)." },
        "draftTokens": { "type": "integer", "minimum": 1, "description": "speculative: draft tokens per step (default 4)." },
        "acceptanceRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "speculative: draft acceptance rate (default 0.7)." },
        "draftCostFraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "speculative: verify-step cost fraction (default 0.2)." },
        "batchSize": { "type": "integer", "minimum": 1, "description": "batched/kvCache: concurrent users / batch (default 1)." },
        "decodeDecayExponent": { "type": "number", "minimum": 0, "maximum": 1, "description": "batched: per-user decode decay exponent (default 0.25)." },
        "numTurns": { "type": "integer", "minimum": 1, "maximum": 50, "description": "agentic: number of turns (default 4, clamped 1-50)." },
        "basePromptTokens": { "type": "integer", "minimum": 0, "description": "agentic: first-turn prompt tokens (default 1500)." },
        "toolOutputTokensPerTurn": { "type": "integer", "minimum": 0, "description": "agentic: tool output tokens per turn (default 800)." },
        "decodeTokensPerTurn": { "type": "integer", "minimum": 0, "description": "agentic: generated tokens per turn (default 250)." },
        "enablePrefixCaching": { "type": ["boolean", "string"], "description": "agentic: prefix caching on/off (default true; 'false' also accepted)." },
        "architecture": {
          "type": "string",
          "enum": ["generic", "llama70b", "llama8b", "qwen72b", "mistral7b"],
          "description": "kvCache: named architecture preset filling numLayers/kvHeads/headDim defaults."
        },
        "numLayers": { "type": "integer", "minimum": 1, "description": "kvCache: transformer layers (default 80 or preset)." },
        "kvHeads": { "type": "integer", "minimum": 1, "description": "kvCache: KV heads (default 8 or preset)." },
        "headDim": { "type": "integer", "minimum": 1, "description": "kvCache: head dimension (default 128 or preset)." },
        "contextLength": { "type": "integer", "minimum": 1, "description": "kvCache: context length in tokens (default 32768)." },
        "precisionBytes": { "type": "number", "minimum": 1, "description": "kvCache: bytes per KV element (default 2)." },
        "flags": { "type": "string", "description": "flagged: comma-separated engine flags (e.g. 'flash-attn,kv-q8')." },
        "hardwarePriceUsd": { "type": "number", "minimum": 0, "description": "cost: hardware price (alias: price)." },
        "electricityRatePerKwh": { "type": "number", "minimum": 0, "description": "cost: USD per kWh (default 0.15; alias: electricityRate)." },
        "powerDrawWatts": { "type": "number", "minimum": 0, "description": "cost: average power draw in watts (default 0)." },
        "amortizationMonths": { "type": "number", "minimum": 0, "description": "cost: amortization window in months (default 36)." },
        "dry_run": {
          "type": ["boolean", "string"],
          "description": "Validate + echo parsed inputs without executing math (aliases: dryRun; 'true'/'1' also accepted)."
        },
        "batch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "object" },
          "description": "Up to 50 parameter sets, each with its own model field (alias: variants)."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "object" },
          "description": "Alias for batch."
        }
      }
    },
    "inputs": {
      "title": "Resolved inputs echoed back on every result",
      "type": "object",
      "properties": {
        "promptTokens": { "type": "number" },
        "outputTokens": { "type": "number" },
        "prefillSpeed": { "type": "number" },
        "decodeSpeed": { "type": "number" },
        "baseDecodeSpeed": { "type": "number" },
        "draftTokens": { "type": "integer" },
        "acceptanceRate": { "type": "number" },
        "draftCostFraction": { "type": "number" },
        "batchSize": { "type": "integer" },
        "decodeDecayExponent": { "type": "number" },
        "numTurns": { "type": "integer" },
        "basePromptTokens": { "type": "integer" },
        "toolOutputTokensPerTurn": { "type": "integer" },
        "decodeTokensPerTurn": { "type": "integer" },
        "enablePrefixCaching": { "type": "boolean" },
        "architecture": { "type": "string" },
        "numLayers": { "type": "integer" },
        "kvHeads": { "type": "integer" },
        "headDim": { "type": "integer" },
        "contextLength": { "type": "integer" },
        "precisionBytes": { "type": "number" },
        "flags": { "type": "string" },
        "hardwarePriceUsd": { "type": "number" },
        "electricityRatePerKwh": { "type": "number" },
        "powerDrawWatts": { "type": "number" },
        "amortizationMonths": { "type": "number" }
      }
    },
    "sanityWarnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["decode_above_bandwidth_roofline", "prefill_above_compute_roofline", "ttft_below_kernel_launch_floor"]
          },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    },
    "singleTurnResult": {
      "type": "object",
      "properties": {
        "inputs": { "$ref": "#/definitions/inputs" },
        "warnings": { "$ref": "#/definitions/sanityWarnings" },
        "ttftSeconds": { "type": "number" },
        "tpotMs": { "type": "number" },
        "decodeSeconds": { "type": "number" },
        "totalWalltimeSeconds": { "type": "number" },
        "effectiveThroughputTokPerSec": { "type": "number" },
        "prefillSharePct": { "type": "number" },
        "decodeSharePct": { "type": "number" }
      },
      "required": ["inputs", "warnings", "ttftSeconds", "tpotMs", "decodeSeconds", "totalWalltimeSeconds"]
    },
    "agenticTurn": {
      "type": "object",
      "properties": {
        "turn": { "type": "integer", "minimum": 1 },
        "totalPromptTokens": { "type": "integer" },
        "newTokensPrefilled": { "type": "integer" },
        "isCached": { "type": "boolean" },
        "prefillSeconds": { "type": "number" },
        "decodeSeconds": { "type": "number" },
        "turnWalltimeSeconds": { "type": "number" },
        "cumulativeWalltimeSeconds": { "type": "number" }
      },
      "required": ["turn", "totalPromptTokens", "newTokensPrefilled", "isCached", "prefillSeconds", "decodeSeconds", "turnWalltimeSeconds", "cumulativeWalltimeSeconds"]
    },
    "batchResult": {
      "type": "object",
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "ok": { "type": "boolean" },
        "result": { "type": "object", "description": "The item's full compute result (present when ok)." },
        "code": { "type": "string", "description": "Machine-readable error code (failed items only)." },
        "error": { "type": "string", "description": "Error message (failed items only)." }
      },
      "required": ["index", "ok"]
    }
  }
}
