:root {
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;

  /* Reworked palette — warm dark, single amber accent. One idea: dark canvas,
     light text, amber = action/decode, blue = prefill. Nothing else colored. */
  --bg-app: #111214;
  --bg-panel: #18191C;
  --bg-inset: #131417;
  --bg-raised: #1E2024;
  --bg-hover: #24262B;

  --text-main: #E8E9EB;
  --text-muted: #9BA0A8;
  --text-subtle: #64686F;

  --border: #26282D;
  --border-strong: #3A3D44;
  --border-focus: #F5B84B;

  --accent: #F5B84B;
  --accent-strong: #FFD07A;
  --accent-dim: rgba(245, 184, 75, 0.10);
  --accent-ink: #201503;

  --prefill: #5CA8E8;
  --prefill-dim: rgba(92, 168, 232, 0.08);
  --prefill-border: rgba(92, 168, 232, 0.30);

  --decode: var(--accent);
  --decode-dim: var(--accent-dim);
  --decode-border: rgba(245, 184, 75, 0.35);

  --agent: #C792EA;
  --agent-dim: rgba(199, 146, 234, 0.08);
  --agent-border: rgba(199, 146, 234, 0.30);

  --danger: #E5735F;
  --warn: var(--accent);

  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;

  --shadow-panel: none;
}
